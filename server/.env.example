# 复制为 .env 使用（server/ 目录下）
# 数据库：开发默认 SQLite；生产/Docker 用 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://chatbot:chatbot-dev-password@localhost:5432/chatbot

# JWT 密钥：生产环境必须换成随机长字符串
SECRET_KEY=dev-insecure-secret-change-me

# LLM 网关：mock（本地开发，无需 API Key）| litellm（真实模型）
LLM_BACKEND=mock
LLM_DEFAULT_MODEL=gpt-4o-mini
# LLM_BACKEND=litellm 时需要配置上游 Key（或用 LiteLLM 代理统一管理）
LLM_API_KEY=
# LLM_BASE_URL=  # 可选：统一指向自建 LiteLLM 代理

# 前端跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000
