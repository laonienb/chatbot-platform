# deploy/.env.prod.example —— **公网部署**环境变量模板
#
# 用法：
#   cp deploy/.env.prod.example deploy/.env.prod
#   然后**逐个填真值**（下面标了 [必填] 的都必须换掉）
#   docker compose --env-file deploy/.env.prod -f deploy/docker-compose.prod.yml up -d --build
#
# ⚠️ `.env.prod` 与 `.env` 一样**不入库**（.gitignore 的 `.env.*` 已覆盖，只放行 *.example）。
#    绝不要把填好的真值提交进 git。
#
# 生成随机值（每条都跑一次，不要复用同一个）：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"

# ─────────────── 数据库 ───────────────
# [必填] PostgreSQL 密码。生成一次随机值；改这里只影响新库，
# 已有 pgdata 卷里的密码不会跟着变（改密码需进容器 ALTER USER）。
POSTGRES_PASSWORD=

# ─────────────── 平台核心 ───────────────
# [必填] JWT 签名密钥。**这个泄漏等于任何人都能伪造任意用户的登录态**。
# 生产绝不能留代码里的 dev-insecure-secret-change-me。
SECRET_KEY=

# [必填] LLM 后端。公网部署**不能**用 mock：APP_ENV=prod 时 mock 会被守卫拒绝启动（红线9）。
# 取值：remote（推荐，走独立模型服务）| litellm（旧直连，退役中）
LLM_BACKEND=remote
APP_ENV=prod

# CORS：默认同源即可。浏览器只跟 web 说话，由 Next 的 rewrites 转发到 server，
# 所以这里通常不用改；仅当前后端**分开部署**（浏览器直连后端）才需要填外网域名。
CORS_ORIGINS=http://localhost:3000

# ─────────────── ⚠️ 公网安全开关 ───────────────
# 注册赠送积分。**保持 0**：/register 是公开、无审核、无频控的接口，
# 任何扫到你网址的人都能无限注册。改成正数 = 给陌生人白送额度。
# 要给熟人发额度，注册后用管理端/数据库手动加。
SIGNUP_GRANT_CREDITS=0

# 每月 token 配额（0 或留空 = 不限额）。公网建议设一个，防单账号刷爆。
# QUOTA_MONTHLY_TOKENS=1000000

# ─────────────── 模型服务 ───────────────
# 平台 → 模型服务的静态 Bearer。**双方成对配置**
#（平台侧本项；服务侧 MS_SERVICE_TOKENS 逗号分隔，可同时放新旧两个值做无停机轮换）
MODEL_SERVICE_TOKEN=
MODEL_SERVICE_BASE_URL=http://model-service:8000
MODEL_SERVICE_MODE=native

# fake = 离线确定性上游（不产生真实费用，回复是假的但链路全真）；
# litellm = 真实上游（需下面 5 项凭证）
MS_UPSTREAM=fake

# 服务侧凭证（与上面 MODEL_SERVICE_TOKEN 成对）
MS_SERVICE_TOKENS=

# 真实上游（MS_UPSTREAM=litellm 时必填这五项）
MS_LITELLM_API_BASE=
MS_LITELLM_API_KEY=
MS_LITELLM_DEFAULT_MODEL=
MS_LITELLM_PROVIDER=openai
# 供应商名：必须与真实出口一致，填错不会报错、只会让账本记错供应商
MS_UPSTREAM_VENDOR=

# 目录白名单（无前缀 model 走它校验；漏了会在到达上游前 404 model_not_found）
MS_CATALOG_MODELS=deepseek-chat,qwen-plus

# ─────────────── 超时与容量（一般不用改；改了要守住约束）───────────────
# 下面这些 compose 里都带默认值，**不填也能跑**；列出来是为了"可发现"——
# 出问题时你知道去哪调，而不是只能去翻 compose 源码。
#
# ⚠️ 红线8（内层必须小于外层）：模型服务的上游超时必须 **< 平台流式空闲上限 90s**，
#    否则平台**启动自检直接拒绝启动**（断言在 server/app/llm/model_service_ops.py）。
#    当前默认 15/30/60 三项都满足；调大时务必重新核对这条。
MS_UPSTREAM_FIRST_TOKEN_TIMEOUT=15      # 首 token（含建连+推理）
MS_UPSTREAM_CHUNK_IDLE_TIMEOUT=30       # chunk 之间最大间隔
MS_UPSTREAM_TOTAL_TIMEOUT=60            # 单请求总时长
MS_UPSTREAM_FIRST_CONTENT_TIMEOUT=60    # 首个**正文** token（到首个非空 delta.content）

# 幂等窗容量（DW-6 定值；算法与分档见 model-service/README.md）
# 公式：max_entries >= 峰值RPS × MS_IDEMPOTENCY_WINDOW_SECONDS
# 默认按 峰值 10 RPS × 600s = 6000 条；chars 与之配套（6000 × 1500 字符 ≈ 9e6）
MS_IDEMPOTENCY_WINDOW_SECONDS=600
MS_IDEMPOTENCY_CACHE_MAX_ENTRIES=6000
MS_IDEMPOTENCY_CACHE_MAX_CHARS=9000000
# SW-5：在飞位兜底（防持有者泄漏后同 key 永久 409）
MS_IDEMPOTENCY_INFLIGHT_TTL_SECONDS=60
# RB-5：错误类入窗的短 TTL。**必须 < 上面那个 WINDOW**，否则服务拒绝启动
MS_IDEMPOTENCY_ERROR_TTL_SECONDS=60

# 合规：命中这些供应商名时**拒绝启动**（红线5 对真实出口的启动期对账）
MS_COMPLIANCE_DENY_PROVIDERS=openai,anthropic

# ─────────────── 入口端口 ───────────────
# 公网唯一入口（web）。改这里可换端口；穿透工具指向这个端口即可。
WEB_PORT=3000
