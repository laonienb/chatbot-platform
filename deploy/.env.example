# deploy/.env.example —— compose 环境变量模板（DW-2 / DW-6）
#
# 用法：`cp deploy/.env.example deploy/.env` 后按需填值；`deploy/docker-compose.yml` 里所有
# `${VAR:-默认}` 会读它。**`deploy/.env` 不入库**（.gitignore 第 22 行排除 `.env`，第 24 行
# 用 `!.env.example` 反向放行本模板）。
#
# ⚠️ 本模板**只是模板**：不含任何真凭证。凭证落点属 **DW-3**、切换到 remote 属 **DW-4**、
# provider 凭证迁入与两列废弃迁移属 **DW-5** —— 三项在工作单 §9 均「待用户定，未开工」，
# 所以此处一律留空值或保持 mock 默认，**不要在这里替用户做那个决定**。

# ─────────────── 平台（server） ───────────────
# DW-4 未派 ⇒ 保持 mock。切 remote 需同时满足：DW-3 有 token、启动自检通过。
LLM_BACKEND=mock
LLM_API_KEY=
SECRET_KEY=dev-insecure-secret-change-me

# DW-2 只配地址，不切开关。容器网络内的服务名 + 端口，非宿主地址。
MODEL_SERVICE_BASE_URL=http://model-service:8000

# 平台 → 模型服务的静态 Bearer（协议 §3，DW-3）。**留空＝不启用**，本行是模板占位；
# 真值**只写不入库的 `deploy/.env`**（见本文件第 3–5 行：`.gitignore` 排除 `.env`、反向放行
# `.env.example`），永远不要把真值提交进来。
# 生成姿势与下面 `MS_SERVICE_TOKENS` 一致（≥32 字节随机）：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# 轮换姿势（无停机，**两边成对改**）：① 新值先**追加**进服务侧 `MS_SERVICE_TOKENS`
# （逗号分隔的双 token 就是为这个并行窗口准备的）⇒ ② 再改平台侧 `MODEL_SERVICE_TOKEN`
# ⇒ ③ 确认平台无 401 `service_auth_failed` ⇒ ④ 最后从 `MS_SERVICE_TOKENS` 摘掉旧值。
# 只改一边＝平台立刻 401，且报错出现在调用链上、不像"配置改了个 token"。
# ⚠️ 填了本行**还不算接线**：compose 里把它传给 server 的那一行此刻仍是注释状态
# （`deploy/docker-compose.yml` 第 47 行），激活属 DW-4（切 remote），本模板不替那个决定。
MODEL_SERVICE_TOKEN=

# ─────────────── 模型服务（model-service） ───────────────
# fake = 离线确定性上游；litellm = 真实上游（需文末那五项：BASE/KEY/DEFAULT_MODEL +
#        MS_LITELLM_PROVIDER 协议名 + MS_UPSTREAM_VENDOR 供应商名，A-1 后两项是新加的）
MS_UPSTREAM=fake

# DW-3（待用户定）：逗号分隔的**双** token，用于无停机轮转（§3）。生产必须换成
# ≥32 字节随机值（例：`python -c "import secrets;print(secrets.token_urlsafe(32))"`），
# 且与平台侧 MODEL_SERVICE_TOKEN 成对更新。内置默认值仅供本地开发。
MS_SERVICE_TOKENS=dev-insecure-model-service-token

MS_COMPLIANCE_DENY_PROVIDERS=openai,anthropic
# 切 MS_UPSTREAM=litellm 真上游时，把目标 model id 追加进来（无前缀 model 走目录校验，漏了在到达上游前就 404 model_not_found，报错像上游故障）。
# 主值与 `model-service/msvc/config.py` 的代码默认**同值**（协议 §27.4 R2 裁定）：目录是白名单
# 并集语义，多列无害、少列必 404；这里写成单值反而会让"装了 compose 注入 env"比裸跑更窄。
# 一次性冒烟用的 model（如 mimo-v2.6-flash）**不写进主值**——它绑一次性调试凭证、凭证不入库。
MS_CATALOG_MODELS=deepseek-chat,qwen-plus

# 超时自持（红线8）：三者都必须 < 平台流式空闲上限 90s，否则平台启动自检拒绝启动
# （断言在 `server/app/llm/model_service_ops.py:startup_self_check`）。
MS_UPSTREAM_FIRST_TOKEN_TIMEOUT=15
MS_UPSTREAM_CHUNK_IDLE_TIMEOUT=30
MS_UPSTREAM_TOTAL_TIMEOUT=60

# ─────────────── DW-6：幂等窗容量（按 H3 公式定值） ───────────────
# 公式：max_entries ≥ 峰值RPS × MS_IDEMPOTENCY_WINDOW_SECONDS
# 假设：峰值 10 RPS ＝ 5 个持续活跃身份 × 平台自身限流上限（`ratelimit.py` 的
#       `rpm_default=120` / 60s ＝ 每身份 2 RPS）⇒ 10 × 600 ＝ 6000 条
# 配套：max_chars ≈ max_entries × 单条终态平均字符数 ≈ 6000 × 1500 ＝ 9000000
# 完整算例、分档表与内存算法见 `model-service/README.md`「幂等窗容量定值（DW-6）」。
MS_IDEMPOTENCY_WINDOW_SECONDS=600
MS_IDEMPOTENCY_CACHE_MAX_ENTRIES=6000
MS_IDEMPOTENCY_CACHE_MAX_CHARS=9000000

# SW-5 的在飞位兜底：持有者泄漏时，超过该秒数的「在飞」标记被强制释放，
# 否则同 key 重发会永久拿 409。默认对齐上游总超时。
MS_IDEMPOTENCY_INFLIGHT_TTL_SECONDS=60

# 真实上游（MS_UPSTREAM=litellm）才需要；凭证本身的落点归 DW-3/DW-5，此处留空
MS_LITELLM_API_BASE=
MS_LITELLM_API_KEY=
MS_LITELLM_DEFAULT_MODEL=

# A-1（协议 §26.6-丙）：**协议名与供应商名分开**——此前两者挤在 model 字符串的前缀里，
# 于是只有两条坏路：发 `openai/xxx` 会撞红线5 的 deny 前缀判定（403），发无前缀 model 则
# litellm 定不出 provider、归因字段回落到 MS_LITELLM_DEFAULT_MODEL 的前缀。
# 协议名：交给 litellm 的 `custom_llm_provider`，只在请求 model 不带 `/` 前缀时使用。
MS_LITELLM_PROVIDER=openai
# 供应商名：进 `x_model_service.provider`，经平台落 `usage_logs.provider` 与供应商统计。
# 留空＝未声明 ⇒ 服务启动只打 WARNING；`MS_UPSTREAM=litellm` 且该值命中
# `MS_COMPLIANCE_DENY_PROVIDERS` ⇒ **拒绝启动**（红线5 对真实出口的启动期对账）。
# ⚠️ 它必须是**真实供应商**：这一项对账的是声明，不是实际出口（`MS_LITELLM_API_BASE` 指向
# 谁，合规检查读不到）。填错不会报错，只会让账本记错供应商。
MS_UPSTREAM_VENDOR=
